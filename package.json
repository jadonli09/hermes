{
  "name": "hermes",
  "version": "1.0.0",
  "description": "Instagram scraper for school club posts with AI processing and Google Sheets integration",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "web": "node web/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "verify:handles": "node verify-handles.js",
    "story": "node story.js",
    "avatars": "node refresh-avatars.js"
  },
  "keywords": [
    "instagram",
    "scraper",
    "claude",
    "google-sheets"
  ],
