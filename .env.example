# ===========================================
# REQUIRED CREDENTIALS
# ===========================================
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
ANTHROPIC_API_KEY=sk-ant-your_key_here
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ===========================================
# REQUIRED CONFIGURATION
# ===========================================
START_DATE=2025-01-01

# ===========================================
# PROCESSING OPTIONS
# ===========================================
MAX_CLUBS_TO_PROCESS=100      # Max number of clubs to scrape per run
PARALLEL_CLUBS=3              # Number of clubs to scrape simultaneously (1-5 recommended)
RESUME=false                  # Resume from previous run if interrupted

# ===========================================
# PERFORMANCE OPTIMIZATIONS (defaults shown)
# ===========================================
# ENABLE_DATE_FIRST_FILTERING=true   # Skip posts outside date range before full extraction
# MAX_CAROUSEL_IMAGES=3              # Limit carousel images to save tokens
# FORCE_MODEL=                       # 'haiku' or 'sonnet' to override auto-selection

# ===========================================
# BROWSER SETTINGS
# ===========================================
# HEADLESS_MODE=false          # Run browser invisibly (true) or visible (false)

# ===========================================
# DELAYS (milliseconds) - increase if getting rate limited
# ===========================================
# DELAY_BETWEEN_CLUBS_MS=3000
# DELAY_AFTER_LOGIN_MS=3000
# DELAY_PROFILE_LOAD_MS=3000
# DELAY_POST_LOAD_MS=2000
# DELAY_AFTER_CLUB_MS=2000
# DELAY_BETWEEN_API_CALLS_MS=1000
